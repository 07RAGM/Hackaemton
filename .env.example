# ---------------------------------------------------------------------------
# Mesh-ResQ GNSS — variables de entorno (copia a `.env` y ajusta)
# ---------------------------------------------------------------------------

# Base de datos espacial.
# Producción / Docker (PostgreSQL + PostGIS):
DATABASE_URL=postgresql+psycopg2://meshresq:meshresq@localhost:5432/meshresq
# Desarrollo rápido sin PostGIS (SQLite, geometrías guardadas como GeoJSON):
# DATABASE_URL=sqlite:///./mesh_resq.db

# Grafo vial local. Por defecto se usa ./data/acapulco/grafo.graphml (Acapulco)
# si existe; si no, ./data/grafo.graphml. Puedes forzar otro:
# MESH_RESQ_GRAFO=./data/acapulco/grafo.graphml

# Centro de la rejilla sintética de respaldo (Acapulco, MX por defecto).
MESH_RESQ_CENTRO_LAT=16.8680495
MESH_RESQ_CENTRO_LON=-99.8940182
MESH_RESQ_NODOS=15
MESH_RESQ_ESPACIADO_M=120

# Velocidad media de respuesta de emergencia en m/s (~30 km/h).
MESH_RESQ_VELOCIDAD_M_S=8.33

# Mapa del dashboard. Por defecto: OpenStreetMap en línea (estilo normal, sin
# API key) desde tile.openstreetmap.de. La retícula táctica local queda como
# respaldo si no hay internet.
#
# Modo offline opcional con teselas descargadas:
# MESH_RESQ_TILES_MODO=offline
# MESH_RESQ_TILES_DIR=./app/static/control/tiles_acapulco
#
# Para forzar otra fuente de teselas:
# MESH_RESQ_TILES_URL=http://mi-servidor-tiles/{z}/{x}/{y}.png
# MESH_RESQ_TILES_ATRIBUCION="© Mi proveedor de teselas"
# Filtro oscuro opcional para teselas claras (OSM): 1 = sí (por defecto 0).
# MESH_RESQ_TILES_OSCURECER=1
